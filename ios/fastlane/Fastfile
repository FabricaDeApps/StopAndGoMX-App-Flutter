default_platform(:ios)

platform :ios do
  ############################################
  # Paths base
  ############################################

  PROJECT_ROOT = File.expand_path('../..', __dir__)   # ios/
  IOS_DIR      = File.expand_path('..', __dir__)      # ios/fastlane/..

  def flutter_bin
    env_bin = ENV['FLUTTER_BIN']
    return env_bin unless env_bin.to_s.strip.empty?

    preferred_bin = File.join(ENV['HOME'], 'fvm', 'versions', '3.41.9', 'bin', 'flutter')
    return preferred_bin if File.exist?(preferred_bin)

    'flutter'
  end

  ############################################
  # API key de App Store Connect
  ############################################
  def app_store_api_key_config
    app_store_connect_api_key(
      key_id: "93W99LJKVU",
      issuer_id: "69a6de76-2be5-47e3-e053-5b8c7c11a4d1",
      key_filepath: File.join(__dir__, "key/auth.p8"),
      duration: 1200,
      in_house: false
    )
  end

  ############################################
  # Changelog (root/CHANGELOG.md)
  ############################################
  def latest_changelog
    changelog_path = File.join(PROJECT_ROOT, "CHANGELOG.md")
    UI.user_error!("No existe CHANGELOG.md en #{changelog_path}") unless File.exist?(changelog_path)

    content = File.read(changelog_path)

    # Toma el bloque entre el primer "## [x.y.z]" y el siguiente "## [" o EOF
    match = content.match(/## \[[^\]]+\][^\n]*\n(.*?)(\n## \[|\z)/m)

    UI.user_error!("No pude extraer release notes del CHANGELOG.md") unless match

    notes = match[1].strip

    # Limpieza ligera: soporta bullets con • o -
    notes = notes.gsub(/\r\n?/, "\n").strip

    UI.message("📝 Release notes detectados desde CHANGELOG.md:")
    UI.message(notes)

    notes
  end

  ############################################
  # Script de logos
  ############################################
  def run_logo_script(flavor:)
    logo_arg = case flavor
               when 'mainapp'
                 'stopandgo'
               else
                 flavor # zorros -> zorros
               end

    UI.message("🎨 Ejecutando script de logo: ./scripts/use_logo.sh #{logo_arg}")
    sh "cd #{PROJECT_ROOT} && ./scripts/use_logo.sh #{logo_arg}"
  end

  ############################################
  # Build iOS (usa Signing automático de Xcode)
  ############################################
  def build_ios_app(flavor:, scheme:, export_method:, export_team_id:, output_name:, output_path:)
    config_name = "Release-#{flavor}"  # Release-mainapp / Release-zorros

    UI.message("🛠  Construyendo iOS (flavor=#{flavor}, scheme=#{scheme}, configuration=#{config_name})...")

    build_app(
      workspace: File.join(IOS_DIR, "Runner.xcworkspace"),
      scheme: scheme,
      configuration: config_name,
      export_method: export_method,
      clean: true,
      output_directory: output_path,
      output_name: output_name,
      include_bitcode: false,
      include_symbols: true,
      xcargs: "-allowProvisioningUpdates"
    )
  end

  ############################################
  # Upload TestFlight
  ############################################
  def upload_to_testflight_generic(bundle_id:, groups:, changelog:)
    UI.message("🚀 Subiendo a TestFlight (bundle_id=#{bundle_id})...")

    upload_to_testflight(
      api_key: app_store_api_key_config,
      app_identifier: bundle_id,
      changelog: changelog,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      uses_non_exempt_encryption: false
    )
  end

  ############################################
  # Submit for review (App Store)
  ############################################
  def submit_appstore_for_review(bundle_id:, changelog:)
    UI.message("📨 Enviando a revisión (submit_for_review) en App Store Connect (bundle_id=#{bundle_id})...")

    deliver(
      api_key: app_store_api_key_config,
      app_identifier: bundle_id,
      release_notes: {
        "es-MX" => changelog
      },
      submit_for_review: true,
      automatic_release: true,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        export_compliance_available_on_french_store: true
      }
    )
  end

  ############################################
  # Lane genérica
  ############################################
  desc "Build & upload iOS (TestFlight) usando Flutter + flavors"
  lane :deploy do |options|
    flavor         = options[:flavor]              # "mainapp" / "zorros"
    scheme         = options[:scheme] || flavor    # normalmente igual al flavor
    bundle_id      = options[:bundle_id]
    export_method  = options[:export_method]  || "app-store"
    export_team_id = options[:export_team_id] || "M25Y63Z23D"

    ipa_name      = options[:ipa_name]      || "stopandgomx-#{flavor}.ipa"
    tester_groups = options[:groups]        || []
    logo_script   = options[:logo_script].nil? ? true : options[:logo_script]
    submit_review = options[:submit_review].nil? ? false : options[:submit_review]

    UI.user_error!("Falta flavor")    if flavor.nil? || flavor.empty?
    UI.user_error!("Falta scheme")    if scheme.nil? || scheme.empty?
    UI.user_error!("Falta bundle_id") if bundle_id.nil? || bundle_id.empty?

    UI.message("➡️  Deploy iOS")
    UI.message("   PROJECT_ROOT:  #{PROJECT_ROOT}")
    UI.message("   flavor:        #{flavor}")
    UI.message("   scheme:        #{scheme}")
    UI.message("   bundle_id:     #{bundle_id}")
    UI.message("   export_method: #{export_method}")
    UI.message("   ipa:           #{ipa_name}")
    UI.message("   submit_review: #{submit_review}")

    ########################################
    # 0) Release notes desde CHANGELOG.md
    ########################################
    notes = latest_changelog

    ########################################
    # 1) Logo script ANTES del build (como tú quieres)
    ########################################
    run_logo_script(flavor: flavor) if logo_script

    ########################################
    # 2) flutter build ios --config-only ...
    ########################################
    UI.message("🔧 flutter build ios --config-only --release --flavor #{flavor}")

    entrypoint = case flavor
                 when "mainapp"
                   "lib/main_mainapp.dart"
                 when "zorros"
                   "lib/main_zorros.dart"
                 when "raidersqro"
                   "lib/main_raidersqro.dart"
                 when "wolverinesqro"
                   "lib/main_wolverinesqro.dart"
                 when "bearsqro"
                   "lib/main_bearsqro.dart"
                 when "celtas"
                   "lib/main_celtas.dart"
                 else
                   UI.user_error!("No conozco el entrypoint para flavor=#{flavor}")
                 end

    UI.message("   Usando entrypoint: #{entrypoint}")
    UI.message("   Usando Flutter: #{flutter_bin}")

    sh "cd #{PROJECT_ROOT} && '#{flutter_bin}' build ios --config-only --release --flavor #{flavor} --target=#{entrypoint}"

    ########################################
    # 3) Build IPA (xcodebuild vía build_app)
    ########################################
    output_path = File.join(PROJECT_ROOT, "build/ios/ipa/#{flavor}")

    build_ios_app(
      flavor: flavor,
      scheme: scheme,
      export_method: export_method,
      export_team_id: export_team_id,
      output_name: ipa_name,
      output_path: output_path
    )

    ########################################
    # 3.5) DEBUG: mostrar CFBundleIdentifier del IPA
    ########################################
    ipa_path = File.join(output_path, ipa_name)
    UI.message("🔍 IPA generado en: #{ipa_path}")

    sh "rm -rf /tmp/ipa_#{flavor}"
    sh "mkdir -p /tmp/ipa_#{flavor}"
    sh "unzip -o '#{ipa_path}' -d /tmp/ipa_#{flavor} >/dev/null"
    UI.message("📦 Leyendo CFBundleIdentifier real del IPA:")
    sh "plutil -p /tmp/ipa_#{flavor}/Payload/*.app/Info.plist | grep CFBundleIdentifier || echo 'CFBundleIdentifier no encontrado'"

    ########################################
    # 4) Upload a TestFlight
    ########################################
    upload_to_testflight_generic(
      bundle_id: bundle_id,
      groups: tester_groups,
      changelog: notes
    )

    ########################################
    # 5) Submit opcional a review (App Store)
    ########################################
    if submit_review
      submit_appstore_for_review(
        bundle_id: bundle_id,
        changelog: notes
      )
    else
      UI.message("⏭️  Omitiendo submit_for_review. El build quedó subido a TestFlight.")
    end

    UI.success("✅ Deploy iOS completado (#{flavor})")
  end

  ############################################
  # Lanes de conveniencia por flavor
  ############################################

  desc "Deploy iOS mainapp (StopAndGo)"
  lane :deploy_mainapp do
    deploy(
      flavor: "mainapp",
      scheme: "mainapp",
      bundle_id: "app.stopandgomx.stopandgo",
      ipa_name: "stopandgo-mainapp.ipa",
      groups: ["internal"]
    )
  end

  desc "Deploy iOS Zorros"
  lane :deploy_zorros do
    deploy(
      flavor: "zorros",
      scheme: "zorros",
      bundle_id: "app.stopandgomx.zorros",
      ipa_name: "stopandgo-zorros.ipa",
      groups: ["internal"]
    )
  end

  desc "Deploy iOS Raiders Qro"
  lane :deploy_raidersqro do
    deploy(
      flavor: "raidersqro",
      scheme: "raidersqro",
      bundle_id: "app.stopandgomx.raidersqro",
      ipa_name: "stopandgo-raidersqro.ipa",
      groups: ["internal"]
    )
  end

  desc "Deploy iOS Wolverines Qro"
  lane :deploy_wolverinesqro do
    deploy(
      flavor: "wolverinesqro",
      scheme: "wolverinesqro",
      bundle_id: "app.stopandgomx.wolverinesqro",
      ipa_name: "stopandgo-wolverinesqro.ipa",
      groups: ["internal"]
    )
  end

  desc "Deploy iOS Bears Corregidora"
  lane :deploy_bearsqro do
    deploy(
      flavor: "bearsqro",
      scheme: "bearsqro",
      bundle_id: "app.stopandgomx.bearsqro",
      ipa_name: "stopandgo-bearsqro.ipa",
      groups: ["internal"]
    )
  end

  desc "Deploy iOS Celtas"
  lane :deploy_celtas do
    deploy(
      flavor: "celtas",
      scheme: "celtas",
      bundle_id: "app.stopandgomx.celtas",
      ipa_name: "stopandgo-celtas.ipa",
      groups: ["internal"],
      submit_review: false
    )
  end
end
