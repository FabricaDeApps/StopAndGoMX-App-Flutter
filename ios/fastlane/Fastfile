default_platform(:ios)

platform :ios do
  ############################################
  # Paths base
  ############################################

  PROJECT_ROOT = File.expand_path('../..', __dir__)
  IOS_DIR      = File.expand_path('..', __dir__)

  ############################################
  # API key de App Store Connect
  ############################################
  def app_store_api_key_config
    app_store_connect_api_key(
      key_id: "93W99LJKVU",
      issuer_id: "69a6de76-2be5-47e3-e053-5b8c7c11a4d1",
      key_filepath: File.join(__dir__, "key/auth.p8"),
      duration: 1200,
      in_house: false
    )
  end

  ############################################
  # Script de logos
  ############################################
  def run_logo_script(flavor:)
    logo_arg = case flavor
               when 'mainapp'
                 'stopandgo'
               else
                 flavor # zorros -> zorros
               end

    UI.message("🎨 Ejecutando script de logo: ./scripts/use_logo.sh #{logo_arg}")
    sh "cd #{PROJECT_ROOT} && ./scripts/use_logo.sh #{logo_arg}"
  end

  ############################################
  # Build iOS (usa Signing automático de Xcode)
  ############################################
  def build_ios_app(flavor:, scheme:, export_method:, export_team_id:, output_name:, output_path:)
    config_name = "Release-#{flavor}"  # Release-mainapp / Release-zorros

    UI.message("🛠  Construyendo iOS (flavor=#{flavor}, scheme=#{scheme}, configuration=#{config_name})...")

    build_app(
      workspace: File.join(IOS_DIR, "Runner.xcworkspace"),
      scheme: scheme,                      # "mainapp" o "zorros"
      configuration: config_name,
      export_method: export_method,        # "app-store"
      clean: true,
      output_directory: output_path,
      output_name: output_name,
      include_bitcode: false,
      include_symbols: true,
      xcargs: "-allowProvisioningUpdates"
    )
  end

  ############################################
  # Upload TestFlight
  ############################################
  def upload_to_testflight_generic(bundle_id:, groups:, changelog:)
    UI.message("🚀 Subiendo a TestFlight (bundle_id=#{bundle_id})...")

    upload_to_testflight(
      api_key: app_store_api_key_config,
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      groups: groups,
      changelog: changelog
    )
  end

  ############################################
  # Lane genérica
  ############################################
  desc "Build & upload iOS (TestFlight) usando Flutter + flavors"
  lane :deploy do |options|
    flavor         = options[:flavor]              # "mainapp" / "zorros"
    scheme         = options[:scheme] || flavor    # normalmente igual al flavor
    bundle_id      = options[:bundle_id]
    export_method  = options[:export_method]  || "app-store"
    export_team_id = options[:export_team_id] || "M25Y63Z23D"

    ipa_name      = options[:ipa_name]      || "stopandgomx-#{flavor}.ipa"
    changelog     = options[:changelog]     || "Nueva compilación para #{flavor}"
    tester_groups = options[:groups]        || []
    logo_script   = options[:logo_script].nil? ? true : options[:logo_script]

    UI.user_error!("Falta flavor")    if flavor.nil? || flavor.empty?
    UI.user_error!("Falta scheme")    if scheme.nil? || scheme.empty?
    UI.user_error!("Falta bundle_id") if bundle_id.nil? || bundle_id.empty?

    UI.message("➡️  Deploy iOS")
    UI.message("   PROJECT_ROOT:  #{PROJECT_ROOT}")
    UI.message("   flavor:        #{flavor}")
    UI.message("   scheme:        #{scheme}")
    UI.message("   bundle_id:     #{bundle_id}")
    UI.message("   export_method: #{export_method}")
    UI.message("   ipa:           #{ipa_name}")

    ########################################
    # 1) Logo script ANTES del build (como tú quieres)
    ########################################
    run_logo_script(flavor: flavor) if logo_script

    ########################################
    # 2) flutter build ios --config-only ...
    ########################################
    UI.message("🔧 flutter build ios --config-only --release --flavor #{flavor}")

    entrypoint = case flavor
                 when "mainapp"
                   "lib/main_mainapp.dart"
                 when "zorros"
                   "lib/main_zorros.dart"
                when "raidersqro"
                   "lib/main_raidersqro.dart"
                 else
                   UI.user_error!("No conozco el entrypoint para flavor=#{flavor}")
                 end

    UI.message("   Usando entrypoint: #{entrypoint}")

    sh "cd #{PROJECT_ROOT} && flutter build ios --config-only --release --flavor #{flavor} --target=#{entrypoint}"

    ########################################
    # 3) Build IPA (xcodebuild vía build_app)
    ########################################
    output_path = File.join(PROJECT_ROOT, "build/ios/ipa/#{flavor}")

    build_ios_app(
      flavor: flavor,
      scheme: scheme,
      export_method: export_method,
      export_team_id: export_team_id,
      output_name: ipa_name,
      output_path: output_path
    )

    ########################################
    # 3.5) DEBUG: mostrar CFBundleIdentifier del IPA
    ########################################
    ipa_path = File.join(output_path, ipa_name)
    UI.message("🔍 IPA generado en: #{ipa_path}")

    sh "rm -rf /tmp/ipa_#{flavor}"
    sh "mkdir -p /tmp/ipa_#{flavor}"
    sh "unzip -o '#{ipa_path}' -d /tmp/ipa_#{flavor} >/dev/null"
    UI.message("📦 Leyendo CFBundleIdentifier real del IPA:")
    sh "plutil -p /tmp/ipa_#{flavor}/Payload/*.app/Info.plist | grep CFBundleIdentifier || echo 'CFBundleIdentifier no encontrado'"

    ########################################
    # 4) Upload a TestFlight
    ########################################
    upload_to_testflight_generic(
      bundle_id: bundle_id,
      groups: tester_groups,
      changelog: changelog
    )

    UI.success("✅ Deploy iOS completado (#{flavor})")
  end

  ############################################
  # Lanes de conveniencia por flavor
  ############################################

  desc "Deploy iOS mainapp (StopAndGo)"
  lane :deploy_mainapp do
    deploy(
      flavor: "mainapp",
      scheme: "mainapp",                       # scheme mainapp en Xcode
      bundle_id: "app.stopandgomx.stopandgo",  # bundle iOS de mainapp
      ipa_name: "stopandgo-mainapp.ipa",
      groups: ["internal"]
    )
  end

  desc "Deploy iOS Zorros"
  lane :deploy_zorros do
    deploy(
      flavor: "zorros",
      scheme: "zorros",                        # scheme zorros en Xcode
      bundle_id: "app.stopandgomx.zorros",
      ipa_name: "stopandgo-zorros.ipa",
      groups: ["internal"]
    )
  end

  desc "Deploy iOS Zorros"
  lane :deploy_raidersqro do
    deploy(
      flavor: "raidersqro",
      scheme: "raidersqro",
      bundle_id: "app.stopandgomx.raidersqro",
      ipa_name: "stopandgo-raidersqro.ipa",
      groups: ["internal"]
    )
  end

end