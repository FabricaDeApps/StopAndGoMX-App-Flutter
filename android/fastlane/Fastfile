# ================================
# fastlane/Fastfile (Android)
# ================================

require 'fileutils'

default_platform(:android)

platform :android do
  ############################################
  # Paths base
  ############################################

  # __dir__  -> /.../StopAndGoMX-App-Flutter/android/fastlane
  PROJECT_ROOT = File.expand_path('../..', __dir__)   # /.../StopAndGoMX-App-Flutter
  ANDROID_DIR  = File.expand_path('..', __dir__)      # /.../StopAndGoMX-App-Flutter/android
  METADATA_DIR = File.join(ANDROID_DIR, 'fastlane/metadata/android')

  ############################################
  # Helpers
  ############################################

  # 0) Script de logo según flavor
  def run_logo_script(flavor:)
    logo_arg = case flavor
               when 'mainapp'
                 'stopandgo'
               else
                 flavor
               end

    UI.message("🎨 Ejecutando script de logo: ./scripts/use_logo.sh #{logo_arg}")
    sh "cd #{PROJECT_ROOT} && ./scripts/use_logo.sh #{logo_arg}"
  end

  # 0.1) Leer release notes desde CHANGELOG.md del root (última versión)
  def latest_changelog_from_root
    changelog_path = File.join(PROJECT_ROOT, 'CHANGELOG.md')
    UI.user_error!("No existe CHANGELOG.md en #{changelog_path}") unless File.exist?(changelog_path)

    content = File.read(changelog_path)

    # Bloque entre el primer "## [x.y.z]" y el siguiente "## [" o EOF
    match = content.match(/## \[[^\]]+\][^\n]*\n(.*?)(\n## \[|\z)/m)
    UI.user_error!("No pude extraer release notes del CHANGELOG.md") unless match

    notes = match[1].strip.gsub(/\r\n?/, "\n").strip

    # Limpieza: convertir bullets "•" a "-" (Play Console suele verse mejor)
    notes = notes.lines.map { |l|
      l2 = l.rstrip
      l2.strip.start_with?('•') ? "- #{l2.strip.sub(/^•\s*/, '')}" : l2
    }.join("\n").strip

    UI.message("📝 Release notes detectados desde CHANGELOG.md:")
    UI.message(notes)

    notes
  end

  # 0.2) Escribir changelog para Google Play como default.txt por locale
  def write_play_changelog_default(locale:, notes:)
    changelog_dir = File.join(METADATA_DIR, locale, 'changelogs')
    FileUtils.mkdir_p(changelog_dir)

    out_path = File.join(changelog_dir, 'default.txt')
    File.write(out_path, notes)

    UI.message("✅ Escribí changelog en: #{out_path}")
    out_path
  end

  # 0.3) Preparar changelog con fallback de locales (evita Invalid request por idioma)
  # Devuelve el locale usado.
  def write_play_changelog_with_fallback(notes:)
    locales = ['es-419', 'es-ES', 'en-US']

    locales.each do |loc|
      begin
        write_play_changelog_default(locale: loc, notes: notes)
        UI.message("✅ Usando changelog locale: #{loc}")
        return loc
      rescue => e
        UI.message("⚠️ No pude preparar changelog para #{loc}: #{e.message}")
      end
    end

    UI.user_error!("No se pudo preparar changelog para ningún locale (#{locales.join(', ')})")
  end

  # 1) Build del AAB usando Flutter
  #    target = path al main.dart del flavor (ej: lib/main_zorros.dart)
  def build_flutter_aab(flavor:, target:)
    UI.message("🛠  Construyendo AAB con Flutter (flavor=#{flavor}, target=#{target})...")
    sh "cd #{PROJECT_ROOT} && flutter pub get"
    sh "cd #{PROJECT_ROOT} && flutter build aab --flavor #{flavor} -t #{target}"
  end

  # 2) Upload del AAB a Google Play
  def upload_aab_to_play(aab_path:, package_name:, track:)
    UI.message("🚀 Subiendo AAB a Google Play (package=#{package_name}, track=#{track})...")

    upload_to_play_store(
      aab: aab_path,
      package_name: package_name,
      track: track,
      json_key: File.join(__dir__, 'playstore.json'),
      release_status: 'completed',
      changes_not_sent_for_review: false,

      # 🔥 Importante: apuntar metadata explícita
      metadata_path: METADATA_DIR,

      # No tocamos listing / imágenes / screenshots
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,

      # ✅ Sí subimos "What's new" (default.txt)
      skip_upload_changelogs: false
    )
  end

  ############################################
  # Lane genérica: deploy
  ############################################

  desc 'Build & upload a Google Play usando Flutter + flavors (lane genérica)'
  lane :deploy do |options|
    flavor       = options[:flavor]
    target       = options[:target]
    package_name = options[:package_name]
    track        = options[:track] || 'internal'

    UI.user_error!('Debes pasar el parámetro flavor')       if flavor.nil? || flavor.empty?
    UI.user_error!('Debes pasar el parámetro target')       if target.nil? || target.empty?
    UI.user_error!('Debes pasar el parámetro package_name') if package_name.nil? || package_name.empty?

    UI.message('➡️  Deploy Android')
    UI.message("   PROJECT_ROOT:  #{PROJECT_ROOT}")
    UI.message("   flavor:        #{flavor}")
    UI.message("   target:        #{target}")
    UI.message("   package_name:  #{package_name}")
    UI.message("   track:         #{track}")

    ########################################
    # 0) Logo script ANTES del build
    ########################################
    run_logo_script(flavor: flavor)

    ########################################
    # 0.5) Generar y escribir changelog para Google Play (fallback)
    ########################################
    notes = latest_changelog_from_root
    used_locale = write_play_changelog_with_fallback(notes: notes)
    UI.message("📝 Changelog preparado usando locale: #{used_locale}")

    ########################################
    # 1) Build AAB con Flutter
    ########################################
    build_flutter_aab(flavor: flavor, target: target)

    ########################################
    # 2) Ruta ABSOLUTA del AAB generado
    ########################################
    aab_path = File.join(
      PROJECT_ROOT,
      "build/app/outputs/bundle/#{flavor}Release/app-#{flavor}-release.aab"
    )

    UI.message("🔍 Buscando AAB en: #{aab_path}")
    UI.user_error!("No se encontró el archivo AAB en: #{aab_path}") unless File.exist?(aab_path)

    ########################################
    # 3) Upload a Google Play
    ########################################
    upload_aab_to_play(
      aab_path: aab_path,
      package_name: package_name,
      track: track
    )

    UI.success("✅ Deploy Android completado (#{flavor} → #{track})")
  end

  ############################################
  # Lanes por organización / flavor
  ############################################

  # MAINAPP (StopAndGo) - PRODUCTION
  desc 'Deploy Android mainapp (StopAndGo) a track PRODUCTION'
  lane :deploy_mainapp_production do
    deploy(
      flavor: 'mainapp',
      target: 'lib/main_mainapp.dart',
      package_name: 'app.stopandgomx.main',
      track: 'production'
    )
  end

  # ZORROS - PRODUCTION
  desc 'Deploy Android Zorros a track PRODUCTION'
  lane :deploy_zorros_production do
    deploy(
      flavor: 'zorros',
      target: 'lib/main_zorros.dart',
      package_name: 'app.stopandgomx.zorros',
      track: 'production'
    )
  end

  # RAIDERS QRO - PRODUCTION
  desc 'Deploy Android RaidersQRO a track PRODUCTION'
  lane :deploy_raidersqro_production do
    deploy(
      flavor: 'raidersqro',
      target: 'lib/main_raidersqro.dart',
      package_name: 'app.stopandgomx.raidersqueretaro',
      track: 'production'
    )
  end

  # WOLVERINES QRO - PRODUCTION
  desc 'Deploy Android WOLVERINES QRO a track PRODUCTION'
  lane :deploy_wolverinesqro_production do
    deploy(
      flavor: 'wolverinesqro',
      target: 'lib/main_wolverinesqro.dart',
      package_name: 'app.stopandgomx.wolverinesqro',
      track: 'production'
    )
  end

  # BEARS CORREGIDORA - PRODUCTION
  desc 'Deploy Android BEARS CORREGIDORA a track PRODUCTION'
  lane :deploy_bearsqro_production do
    deploy(
      flavor: 'bearsqro',
      target: 'lib/main_bearsqro.dart',
      package_name: 'app.stopandgomx.bearsqro',
      track: 'production'
    )
  end

  # CELTAS - PRODUCTION
  desc 'Deploy Android Celtas a track PRODUCTION'
  lane :deploy_celtas_production do
    deploy(
      flavor: 'celtas',
      target: 'lib/main_celtas.dart',
      package_name: 'app.stopandgomx.celtas',
      track: 'production'
    )
  end
end
